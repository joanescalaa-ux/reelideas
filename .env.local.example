# ── Claude / Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Apify ───────────────────────────────────────────────────────────────────
# https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_...

# ── Notion ──────────────────────────────────────────────────────────────────
# https://www.notion.so/my-integrations → crear integración → "Internal Integration Secret"
NOTION_API_KEY=secret_...
# ID de la base de datos (UUID de la URL de la BD, antes del "?v=")
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Dashboard → Settings → API → service_role key (¡no la anon key!)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=cambia_esto_por_un_secreto_aleatorio
# URL de tu app (en local: http://localhost:3000 | en Vercel: tu dominio HTTPS)
NEXTAUTH_URL=http://localhost:3000
